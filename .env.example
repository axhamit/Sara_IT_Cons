# MongoDB connection (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/neurova

# Long random string, e.g. run: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# First admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisPassword123

# Public URL of the site (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
